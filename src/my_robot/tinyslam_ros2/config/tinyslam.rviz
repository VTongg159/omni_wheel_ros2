Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Displays:
    - Alpha: 0.7
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Name: OccupancyGrid
      Topic:
        Value: /map
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Value: true
    - Angle Tolerance: 0.1
      Class: rviz_default_plugins/LaserScan
      Color: 255; 0; 0
      Name: LaserScan
      Size (m): 0.05
      Topic:
        Value: /scan
      Value: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: TopDownOrtho
