<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aws_robomaker_hospital_world</name>
  <version>3.0.0</version>
  <description>
    AWS RoboMaker package for a hospital world with multiple rooms and furniture for Gazebo simulations.
  </description>
  <license>Apache-2.0</license>
  <author email="ros-contributions@amazon.com">AWS RoboMaker</author>
  <maintainer email="ros-contributions@amazon.com">AWS RoboMaker</maintainer>

  <!-- Hệ thống build của ROS 2 -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Các dependencies khi chạy thực tế (Runtime) -->
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_plugins</exec_depend>
  
  <export>
    <!-- Khai báo loại build cho colcon nhận diện -->
    <build_type>ament_cmake</build_type>
    
    <!-- Export đường dẫn model cho Gazebo -->
    <gazebo_ros gazebo_model_path="${prefix}/models:${prefix}/fuel_models"/>
  </export>
</package>